@* Маршрутизація з перевіркою входу: сторінки з [Authorize] без входу ведуть на /login, без потрібної ролі — показують «немає доступу». *@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <MudAlert Severity="Severity.Warning" Class="ma-4">У вашої ролі немає доступу до цієї сторінки.</MudAlert>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
