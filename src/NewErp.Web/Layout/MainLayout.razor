@inherits LayoutComponentBase
@inject ApiAuthenticationStateProvider Auth
@inject NavigationManager Navigation

@* Спільні постачальники MudBlazor: тема, спливаючі меню, діалоги, повідомлення. *@
<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Меню" />
        <MudText Typo="Typo.h6" Class="ml-2">NewErp</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-2">@context.User.Identity?.Name</MudText>
                <MudTooltip Text="Змінити пароль">
                    <MudIconButton Icon="@Icons.Material.Filled.Key" Color="Color.Inherit" Href="change-password" aria-label="Змінити пароль" />
                </MudTooltip>
                <MudTooltip Text="Вийти">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" aria-label="Вийти" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private static readonly MudTheme Theme = new();

    // Пароль, виданий адміном, тимчасовий: доки його не змінено, пускаємо лише на сторінку зміни пароля.
    protected override void OnParametersSet()
    {
        if (Auth.User is { MustChangePassword: true } && !Navigation.Uri.EndsWith("/change-password", StringComparison.Ordinal))
            Navigation.NavigateTo("change-password");
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
