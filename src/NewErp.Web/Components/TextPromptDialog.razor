@* Простий діалог «введіть текст». Повертає Ok(рядок). *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Value" Label="@Label" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" MaxLength="@MaxLength"
                      OnKeyUp="OnKeyUp" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Скасувати</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="string.IsNullOrWhiteSpace(Value)">Зберегти</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance Dialog { get; set; }

    [Parameter] public string Label { get; set; } = "";

    [Parameter] public string Value { get; set; } = "";

    [Parameter] public int MaxLength { get; set; } = 255;

    private void OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            Save();
    }

    private void Save()
    {
        if (!string.IsNullOrWhiteSpace(Value))
            Dialog.Close(DialogResult.Ok(Value.Trim()));
    }
}
