<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Веб-інтерфейс NewErp. Роздається з NewErp.Api за адресою /app/ і говорить з API лише через HTTP. -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Файли інтерфейсу лежать під /app/, щоб адреси сторінок не перетиналися з адресами API (/orders, /stock...). -->
    <StaticWebAssetBasePath>app</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.13" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лише заради готових record-ів запитів і відповідей (LoginRequest, CurrentUser...). Сервіси інтерфейс не викликає. -->
    <ProjectReference Include="..\NewErp.Application\NewErp.Application.csproj" />
  </ItemGroup>

</Project>
