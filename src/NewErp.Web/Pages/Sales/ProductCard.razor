@page "/catalog/products/{Id:int}"
@attribute [Authorize(Roles = Access.Orders)]
@inject ProductsApi Api
@inject ISnackbar Snackbar

<PageTitle>@(_product?.Name ?? $"Товар {Id}") — NewErp</PageTitle>

<MudLink Href="@ProductRoutes.List" Typo="Typo.body2">← Товари</MudLink>

@if (_notFound)
{
    <MudText Class="mt-3" data-test="not-found">Товар №@Id не знайдено.</MudText>
}
else if (_product is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="d-flex align-center gap-3 mb-3">
        <MudText Typo="Typo.h4">@(string.IsNullOrWhiteSpace(_product.Name) ? $"Товар №{_product.Id}" : _product.Name)</MudText>
        <MudChip T="string" Size="Size.Small" Color="@(_product.Enabled ? Color.Success : Color.Default)">@(_product.Enabled ? "увімкнено" : "вимкнено")</MudChip>
        <MudSpacer />
        <MudText Typo="Typo.h5">@Fmt.Money(_product.Price)</MudText>
    </div>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudSimpleTable Dense="true" Elevation="0" data-test="details">
                    <tbody>
                        <tr><td>№</td><td>@_product.Id</td></tr>
                        <tr><td>Модель</td><td>@_product.Model</td></tr>
                        <tr><td>Категорії</td><td>@Names(_product.Categories)</td></tr>
                        <tr><td>Мітки</td><td>@Names(_product.Labels)</td></tr>
                        <tr><td>Залишок усього</td><td>@_product.Quantity</td></tr>
                        <tr><td>Змінено</td><td>@Fmt.Date(_product.DateModified)</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
            <MudPaper Class="pa-3" Outlined="true" data-test="edit">
                <MudText Typo="Typo.h6" Class="mb-2">Змінити</MudText>
                <MudNumericField T="decimal?" @bind-Value="_price" Label="Ціна, грн" Min="0" Format="0.##" data-test="price" />
                <MudCheckBox T="bool" @bind-Value="_enabled" Label="Показувати на сайті" data-test="enabled" />
                <MudText Typo="Typo.caption">Вимкнений товар зникає з сайту, і виробництво не передає йому залишки через категорію.</MudText>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_categoryIds" Label="Категорії" ToStringFunc="CategoryName" Class="mt-2">
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem T="int" Value="category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_labelIds" Label="Мітки" ToStringFunc="LabelName" Class="mt-2">
                    @foreach (var label in _labels)
                    {
                        <MudSelectItem T="int" Value="label.Id">@label.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveAsync" Disabled="_busy" data-test="save">Зберегти</MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.body2" Class="mb-2">
                    Залишки за розмірами оновлює виробництво з пошитого складу; опис, фото й нові товари — в адмінці OpenCart.
                </MudText>
                @if (_product.Sizes.Count == 0)
                {
                    <MudText Typo="Typo.body2">У товару немає розмірів.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" data-test="sizes">
                        <thead><tr><th>Розмір</th><th style="text-align: right">Залишок</th></tr></thead>
                        <tbody>
                            @foreach (var size in _product.Sizes)
                            {
                                <tr><td>@size.Name</td><td style="text-align: right">@size.Quantity</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductCardDto? _product;
    private bool _notFound;
    private bool _busy;
    private IReadOnlyList<LookupItem> _categories = [];
    private IReadOnlyList<LookupItem> _labels = [];
    private decimal? _price;
    private bool _enabled;
    private IReadOnlyCollection<int> _categoryIds = [];
    private IReadOnlyCollection<int> _labelIds = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _notFound = false;
            Show(await Api.GetAsync(Id));
        }
        catch (ApiException)
        {
            _notFound = true;
            return;
        }
        _labels = await Api.LabelsAsync();
        // Категорія, яку потім вимкнули, лишається доступною для товару, що вже в ній.
        var enabled = await Api.CategoriesAsync();
        _categories = enabled.Concat(_product!.Categories.Where(c => enabled.All(e => e.Id != c.Id))).ToList();
    }

    private async Task SaveAsync()
    {
        if (_price is null)
        {
            Snackbar.Add("Вкажіть ціну.", Severity.Error);
            return;
        }
        _busy = true;
        try
        {
            // Надсилаємо date_modified, з яким картку відкрили: зміна з OpenCart тим часом не загубиться (409).
            Show(await Api.UpdateAsync(Id, new UpdateProductRequest(_price, _enabled, _labelIds.ToList(), _categoryIds.ToList(), _product!.DateModified)));
            Snackbar.Add("Збережено.", Severity.Success);
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Show(ProductCardDto product)
    {
        _product = product;
        _price = product.Price;
        _enabled = product.Enabled;
        _categoryIds = product.Categories.Select(c => c.Id).ToHashSet();
        _labelIds = product.Labels.Select(l => l.Id).ToHashSet();
    }

    private string CategoryName(int id) => _categories.FirstOrDefault(c => c.Id == id)?.Name ?? $"#{id}";

    private string LabelName(int id) => _labels.FirstOrDefault(l => l.Id == id)?.Name ?? $"#{id}";

    public static string Names(IReadOnlyList<LookupItem> items) => items.Count == 0 ? "—" : string.Join(", ", items.Select(i => i.Name));
}
