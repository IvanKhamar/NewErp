@page "/orders/{Id:int}"
@attribute [Authorize(Roles = Access.Orders)]
@inject OrdersApi Api
@inject FinanceApi Finance
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject Clipboard Clipboard
@inject NavigationManager Navigation

<PageTitle>Замовлення №@Id — NewErp</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_order is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex align-center flex-wrap gap-2 mb-3">
        <MudText Typo="Typo.h4">Замовлення №@_order.Id</MudText>
        <StatusChip Name="@(_order.StatusName ?? $"статус {_order.StatusId}")" Color="@ColorOf(_order.StatusId)" Size="Size.Medium" />
        <MudSpacer />
        <MudText Typo="Typo.h5">@Fmt.Money(_order.Total)</MudText>
    </div>

    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">@_order.Customer</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><td>Телефон</td><td>@_order.Telephone</td></tr>
                        <tr><td>Email</td><td>@(string.IsNullOrEmpty(_order.Email) ? "—" : _order.Email)</td></tr>
                        <tr><td>Доставка</td><td>@_order.ShippingMethod @_order.ShippingCity @_order.ShippingAddress</td></tr>
                        <tr><td>Оплата</td><td>@_order.PaymentMethod</td></tr>
                        <tr><td>Джерело</td><td>@(_order.SourceName ?? "—")</td></tr>
                        <tr><td>Створено</td><td>@Fmt.Date(_order.DateAdded)</td></tr>
                        @if (!string.IsNullOrWhiteSpace(_order.Comment))
                        {
                            <tr><td>Коментар</td><td style="white-space: pre-line">@_order.Comment</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.h6">Товари</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AssignmentReturn" OnClick="CreateReturnAsync"
                           Disabled="@(_busy || _order.Products.Count == 0)" Class="mr-2" data-test="create-return">Повернення</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditCompositionAsync"
                           Disabled="_busy" data-test="edit-composition">Змінити склад</MudButton>
            </div>
            <MudSimpleTable Dense="true" Outlined="true" Elevation="0" Class="mb-4">
                <thead>
                    <tr><th>Товар</th><th>Артикул</th><th style="text-align: right">К-сть</th><th style="text-align: right">Ціна</th><th style="text-align: right">Сума</th></tr>
                </thead>
                <tbody>
                    @foreach (var product in _order.Products)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td>@product.Model</td>
                            <td style="text-align: right">@product.Quantity</td>
                            <td style="text-align: right">@Fmt.Money(product.Price)</td>
                            <td style="text-align: right">@Fmt.Money(product.Total)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudText Typo="Typo.h6" Class="mb-2">Історія статусів</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-4">
                @foreach (var entry in _order.StatusHistory)
                {
                    <MudTimelineItem Size="Size.Small">
                        <MudText Typo="Typo.body2"><b>@(entry.NewStatusName ?? $"статус {entry.NewStatusId}")</b></MudText>
                        <MudText Typo="Typo.caption">@Fmt.Date(entry.ChangedAt) · @(entry.UserName ?? $"користувач {entry.UserId}")</MudText>
                    </MudTimelineItem>
                }
            </MudTimeline>
            @if (_order.StatusHistory.Count == 0)
            {
                <MudText Typo="Typo.body2">Статус ще не змінювали.</MudText>
            }
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Статус</MudText>
                <div class="d-flex align-center gap-2">
                    <MudSelect T="int" @bind-Value="_newStatusId" Label="Новий статус" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var status in _statuses)
                        {
                            <MudSelectItem T="int" Value="status.Id">@status.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangeStatusAsync"
                               Disabled="_busy || _newStatusId == _order.StatusId" data-test="change-status">Змінити</MudButton>
                </div>
                @if (_warnings.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3" data-test="warnings">
                        Статус змінено, але склад попереджає:
                        <ul class="mt-1">
                            @foreach (var warning in _warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </MudAlert>
                }
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Відповідальний менеджер</MudText>
                <div class="d-flex align-center gap-2">
                    <MudSelect T="int?" @bind-Value="_managerId" Label="Менеджер" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var manager in _managers)
                        {
                            <MudSelectItem T="int?" Value="manager.Id">@manager.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" OnClick="AssignManagerAsync" Disabled="_busy || _managerId is null || _managerId == _order.ManagerId">
                        Призначити
                    </MudButton>
                </div>
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Доставка</MudText>
                @if (_shipment is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">ТТН ще не створено.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LocalShipping"
                               OnClick="CreateShipmentAsync" Disabled="_busy" data-test="create-shipment">Створити ТТН</MudButton>
                }
                else
                {
                    <div class="d-flex align-center flex-wrap gap-2 mb-2">
                        <MudText Typo="Typo.h6" Style="font-family: monospace" data-test="ttn">@_shipment.Number</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Скопіювати ТТН"
                                       OnClick="() => CopyAsync(_shipment.Number)" />
                        <ShipmentStatusChip Tone="_shipment.Tone" Text="@(string.IsNullOrEmpty(_shipment.Status) ? "статус ще не оновлювали" : _shipment.Status)" />
                    </div>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @if (!string.IsNullOrEmpty(_shipment.RecipientAddress))
                            {
                                <tr><td>Куди</td><td>@_shipment.RecipientAddress</td></tr>
                            }
                            <tr><td>Вартість доставки</td><td>@Fmt.Money(_shipment.Cost)</td></tr>
                            @if (_shipment.DateScheduled is { } scheduled)
                            {
                                <tr><td>Планова доставка</td><td>@scheduled.ToString("dd.MM.yyyy")</td></tr>
                            }
                            @if (_shipment.DatePayedKeeping is { } keeping)
                            {
                                <tr><td>Платне зберігання з</td><td>@keeping.ToString("dd.MM.yyyy")</td></tr>
                            }
                            @if (_shipment.Redelivery)
                            {
                                <tr><td>Зворотна доставка</td><td>так (грошовий переказ)</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    @* PDF відкривається в новій вкладці напряму з нашого API: ключ Нової Пошти браузер не бачить. *@
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" Target="_blank"
                                   Href="@OrdersApi.ShipmentPrintUrl(Id, ShipmentPrintKind.Document)">Друк ТТН</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.QrCode" Target="_blank"
                                   Href="@OrdersApi.ShipmentPrintUrl(Id, ShipmentPrintKind.Markings)">Маркування</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="DeleteShipmentAsync" Disabled="@(_busy || _shipment.IsFinal)" data-test="delete-shipment">Видалити ТТН</MudButton>
                    </div>
                }
            </MudPaper>

            <AuthorizeView Roles="@Access.Finance">
                <MudPaper Class="pa-4 mb-4" Outlined="true" data-test="finance">
                    <MudText Typo="Typo.h6" Class="mb-2">Чек і оплата</MudText>
                    @if (_cheque is null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Фіскального чека ще немає.</MudText>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PointOfSale" OnClick="IssueChequeAsync" Disabled="_busy"
                                   data-test="issue-cheque">Видати чек</MudButton>
                    }
                    else
                    {
                        <div class="d-flex align-center flex-wrap gap-2" data-test="cheque">
                            <MudText>Чек №@_cheque.Id на @Fmt.Money(_cheque.Sum), касир @_cheque.Cashier</MudText>
                            @if (_cheque.IsFiscalized)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">фіскалізовано</MudChip>
                                @if (_cheque.ReceiptUrl is { } url)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="@url" Target="_blank" StartIcon="@Icons.Material.Filled.Receipt">Відкрити чек</MudButton>
                                }
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Checkbox не прийняв</MudChip>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="IssueChequeAsync" Disabled="_busy">Повторити</MudButton>
                            }
                        </div>
                    }
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Надходження на рахунок</MudText>
                    @if (_payments.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Банківських платежів до замовлення не прив'язано.</MudText>
                    }
                    @foreach (var payment in _payments)
                    {
                        <MudText Typo="Typo.body2" data-test="payment">@Fmt.Date(payment.Timestamp) · <b>@Fmt.Money(payment.Amount)</b> · @payment.Payer</MudText>
                    }
                </MudPaper>
                <LiqPayPanel OrderId="Id" Total="_order.Total" />
            </AuthorizeView>

            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">SMS клієнту</MudText>
                @if (_smsConfigured == false)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-test="sms-stub">Токен SMSClub не задано: SMS не надсилаються, спроба лише записується в журнал.</MudAlert>
                }
                <MudTextField @bind-Value="_smsText" Label="Текст" Lines="3" Variant="Variant.Outlined" MaxLength="670" Counter="670" Immediate="true" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sms" Class="mt-2" OnClick="SendSmsAsync"
                           Disabled="_busy || string.IsNullOrWhiteSpace(_smsText)" data-test="send-sms">Надіслати на @_order.Telephone</MudButton>
                @foreach (var sms in _sms)
                {
                    <MudPaper Class="pa-2 mt-2" Elevation="0" Style="background: var(--mud-palette-background-gray)">
                        <MudText Typo="Typo.caption">@Fmt.Date(sms.SentAt) · @sms.Phone</MudText>
                        <MudText Typo="Typo.body2" Style="white-space: pre-line">@sms.Text</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@sms.Response</MudText>
                    </MudPaper>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private OrderDetails? _order;
    private List<OrderStatusDto> _statuses = [];

    private string? ColorOf(int statusId) => _statuses.FirstOrDefault(s => s.Id == statusId)?.Color;
    private List<LookupItem> _managers = [];
    private List<SmsDto> _sms = [];
    private ShipmentDto? _shipment;
    private ChequeDto? _cheque;
    private List<BankPaymentDto> _payments = [];
    private int _newStatusId;
    private int? _managerId;
    private string _smsText = "";
    private bool? _smsConfigured;
    private List<string> _warnings = [];
    private string? _error;
    private bool _busy;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _statuses = await Api.StatusesAsync();
            _managers = await Api.ManagersAsync();
            _smsConfigured = await SmsConfiguredAsync();
            await LoadAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    // Підказку про заглушку показуємо лише коли сервер точно сказав, що SMS-сервіс не підключено.
    private async Task<bool?> SmsConfiguredAsync()
    {
        try
        {
            return (await Api.SmsSettingsAsync()).IsConfigured;
        }
        catch (ApiException)
        {
            return null;
        }
    }

    private async Task LoadAsync()
    {
        _order = await Api.GetAsync(Id);
        _sms = await Api.SmsAsync(Id);
        _shipment = await Api.ShipmentAsync(Id);
        await LoadFinanceAsync();
        _newStatusId = _order.StatusId;
        _managerId = _order.ManagerId;
        _breadcrumbs = [new("Замовлення", href: "orders"), new($"№{Id}", href: null, disabled: true)];
    }

    // Зміна статусу може списати чи повернути пошиті вироби; про нестачу склад повідомляє в warnings.
    private Task ChangeStatusAsync() => RunAsync("Статус змінено.", async () =>
        _warnings = (await Api.ChangeStatusAsync(Id, _newStatusId)).Warnings.ToList());

    private Task AssignManagerAsync() => RunAsync("Менеджера призначено.", () => Api.AssignManagerAsync(Id, _managerId!.Value));

    private Task SendSmsAsync() => RunAsync(null, async () =>
    {
        var result = await Api.SendSmsAsync(Id, _smsText);
        if (result.TtnMismatch is { } mismatch)
        {
            // Як на старому сайті: номер ТТН з іншого замовлення в тексті — майже напевно не той номер.
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                "ТТН з іншого замовлення",
                $"ТТН {mismatch.Ttn} належить замовленню №{mismatch.TtnOrderId}, а не цьому. Все одно надіслати?",
                yesText: "Надіслати", cancelText: "Виправити текст");
            if (confirmed != true)
                return;
            result = await Api.SendSmsAsync(Id, _smsText, force: true);
        }

        Snackbar.Add(result.Sent ? "SMS надіслано." : $"SMS записано в журнал, але не надіслано. Відповідь сервісу: {result.Message?.Response}",
            result.Sent ? Severity.Success : Severity.Warning);
        _smsText = "";
    });

    // Чек і платежі — окремий розділ (каса): якщо він недоступний чи впав, решта картки однаково працює.
    private async Task LoadFinanceAsync()
    {
        try
        {
            _cheque = await Finance.OrderChequeAsync(Id);
            _payments = await Finance.OrderPaymentsAsync(Id);
        }
        catch (ApiException)
        {
            (_cheque, _payments) = (null, []);
        }
    }

    private Task IssueChequeAsync() => RunAsync(null, async () =>
    {
        var cheque = await Finance.IssueChequeAsync(Id, null);
        Snackbar.Add(cheque.IsFiscalized ? "Чек фіскалізовано." : "Чек створено, але Checkbox його не прийняв.",
            cheque.IsFiscalized ? Severity.Success : Severity.Warning);
    });

    private async Task CreateShipmentAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateShipmentDialog>("Нова ТТН",
            new DialogParameters<CreateShipmentDialog> { { d => d.OrderId, Id } },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: ShipmentDto shipment })
            return;
        _shipment = shipment;
        Snackbar.Add($"ТТН {shipment.Number} створено.", Severity.Success);
    }

    private async Task EditCompositionAsync()
    {
        var dialog = await Dialogs.ShowAsync<EditCompositionDialog>("Склад замовлення",
            new DialogParameters<EditCompositionDialog> { { d => d.OrderId, Id } },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: UpdateOrderCompositionResult result })
            return;
        Snackbar.Add($"Склад змінено. Сума: {Fmt.Money(result.Total)}.", Severity.Success);
        foreach (var warning in result.Warnings)
            Snackbar.Add(warning, Severity.Warning);
        await LoadAsync();
    }

    private async Task CreateReturnAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateReturnDialog>("Повернення товару",
            new DialogParameters<CreateReturnDialog> { { d => d.OrderId, Id }, { d => d.Products, _order!.Products } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: int returnId })
            Navigation.NavigateTo(ReturnRoutes.Return(returnId));
    }

    private async Task DeleteShipmentAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Видалити ТТН?", $"ТТН {_shipment!.Number} буде видалено в Новій Пошті й у замовленні.",
            yesText: "Видалити", cancelText: "Залишити");
        if (confirmed == true)
            await RunAsync("ТТН видалено.", () => Api.DeleteShipmentAsync(Id));
    }

    private async Task CopyAsync(string text)
    {
        await Clipboard.CopyAsync(text);
        Snackbar.Add("Скопійовано.", Severity.Info);
    }

    private async Task RunAsync(string? success, Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            if (success is not null)
                Snackbar.Add(success, Severity.Success);
            await LoadAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
