@inject StockApi Api
@inject ISnackbar Snackbar

@* Переміщення розхідника між складами; загальний залишок не змінюється. Повертає Ok з новими місцями. *@
<MudDialog>
    <DialogContent>
        <WarehouseSelect @bind-Value="_from" Warehouses="Warehouses" Label="Звідки" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="mb-3 d-block">Там є: @Fmt.Qty(Available(_from)) @Placement.Unit</MudText>
        <WarehouseSelect @bind-Value="_to" Warehouses="Warehouses" Label="Куди" Class="mb-3" />
        <MudNumericField T="decimal" @bind-Value="_quantity" Format="0.###" Label="@($"Кількість, {Placement.Unit}")" Min="0" Step="1"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudTextField @bind-Value="_comment" Label="Коментар" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="255" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Скасувати</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Перемістити</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance Dialog { get; set; }

    [Parameter, EditorRequired] public required ItemPlacementDto Placement { get; set; }

    [Parameter, EditorRequired] public required IReadOnlyList<LookupItem> Warehouses { get; set; }

    private int? _from;
    private int? _to;
    private decimal _quantity;
    private string _comment = "";
    private string? _error;
    private bool _busy;

    protected override void OnInitialized() => _to = Warehouses.FirstOrDefault()?.Id;

    private decimal Available(int? warehouseId) => Placement.Places.FirstOrDefault(p => p.WarehouseId == warehouseId)?.Quantity ?? 0;

    private async Task SaveAsync()
    {
        if (_quantity <= 0)
        {
            _error = "Вкажіть кількість, більшу за нуль.";
            return;
        }

        _busy = true;
        try
        {
            var placement = await Api.TransferAsync(Placement.ItemId, new TransferStockRequest(_from, _to, _quantity, _comment));
            Snackbar.Add($"{Placement.Name}: переміщено {Fmt.Qty(_quantity)} {Placement.Unit}.", Severity.Success);
            Dialog.Close(DialogResult.Ok(placement));
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
