@page "/stock/items/{Id:int}"
@attribute [Authorize(Roles = Access.Stock)]
@inject StockApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(_item?.Name ?? "Розхідник") — NewErp</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_item is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex align-center flex-wrap gap-2 mb-3">
        <MudText Typo="Typo.h4">@_item.Name</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">Змінити</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapVert" OnClick="AdjustAsync">Прихід або витрата</MudButton>
    </div>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.overline">Залишок</MudText>
                <MudText Typo="Typo.h4" Color="@(_item.IsBelowMinimum ? Color.Warning : Color.Default)" data-test="quantity">
                    @Fmt.Qty(_item.Quantity) @_item.Unit
                </MudText>
                @if (_item.IsBelowMinimum)
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning">Нижче мінімуму — варто дозамовити.</MudText>
                }
                <MudDivider Class="my-3" />
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><td>Категорія</td><td>@(_item.CategoryName ?? "—")</td></tr>
                        <tr><td>Постачальник</td><td>@(_item.SupplierName ?? "—")</td></tr>
                        <tr><td>Ціна</td><td>@(_item.Price > 0 ? Fmt.Money(_item.Price) : "—")</td></tr>
                        <tr><td>Для чого</td><td>@(string.IsNullOrEmpty(_item.UsedFor) ? "—" : _item.UsedFor)</td></tr>
                    </tbody>
                </MudSimpleTable>
                <div class="d-flex align-center gap-2 mt-3">
                    <MudNumericField T="decimal" @bind-Value="_minQuantity" Format="0.###" Label="@($"Мінімальний залишок, {_item.Unit}")" Min="0"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton Variant="Variant.Outlined" Disabled="_minQuantity == _item.MinQuantity" OnClick="SaveMinimumAsync">Зберегти</MudButton>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h6" Class="mb-2">Журнал руху</MudText>
            <MudTable T="StockMovementDto" Items="_movements" Dense="true" Hover="true" Outlined="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Коли</MudTh>
                    <MudTh Style="text-align: right">Зміна</MudTh>
                    <MudTh Style="text-align: right">Стало</MudTh>
                    <MudTh>Причина</MudTh>
                    <MudTh>Хто</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Коли">@Fmt.Date(context.CreatedAt)</MudTd>
                    <MudTd DataLabel="Зміна" Style="text-align: right">
                        <MudText Typo="Typo.body2" Color="@(context.Delta > 0 ? Color.Success : Color.Error)">
                            @(context.Delta > 0 ? "+" : "−")@Fmt.Qty(Math.Abs(context.Delta))
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Стало" Style="text-align: right">@Fmt.Qty(context.QuantityAfter)</MudTd>
                    <MudTd DataLabel="Причина">@context.Reason</MudTd>
                    <MudTd DataLabel="Хто">@context.Username</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>Руху ще не було.</MudText></NoRecordsContent>
            </MudTable>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private StockItemDto? _item;
    private List<StockMovementDto> _movements = [];
    private decimal _minQuantity;
    private string? _error;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _item = await Api.ItemAsync(Id);
            _movements = await Api.MovementsAsync(Id);
            _minQuantity = _item.MinQuantity;
            _breadcrumbs = [new("Розхідники", href: "stock"), new(_item.Name, href: null, disabled: true)];
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private async Task AdjustAsync()
    {
        var dialog = await Dialogs.ShowAsync<AdjustStockDialog>(
            $"Прихід або витрата: {_item!.Name}", new DialogParameters<AdjustStockDialog> { { d => d.Item, _item } });
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private async Task EditAsync()
    {
        var dialog = await Dialogs.ShowAsync<ItemDialog>("Змінити розхідник", new DialogParameters<ItemDialog> { { d => d.Item, _item } });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Зміни збережено.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task SaveMinimumAsync()
    {
        try
        {
            await Api.SetMinQuantityAsync(Id, _minQuantity);
            Snackbar.Add("Мінімальний залишок змінено.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }
}
