@page "/stock/purchase-orders/{Id:int}"
@attribute [Authorize(Roles = Access.Stock)]
@using NewErp.Domain.Stock
@inject StockApi Api
@inject Clipboard Clipboard
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Замовлення №@Id — NewErp</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

@if (_order is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex align-center flex-wrap gap-2 mb-1">
        <MudText Typo="Typo.h4">Замовлення №@_order.Id</MudText>
        <MudChip T="string" Color="@PurchaseStatus.Color(_order.Status)" data-test="status">@PurchaseStatus.Label(_order.Status)</MudChip>
        <MudSpacer />
        <MudText Typo="Typo.h6">@Fmt.Money(_order.Total)</MudText>
    </div>
    <MudText Typo="Typo.body1" Class="mb-3">
        @_order.SupplierName @(string.IsNullOrEmpty(_order.SupplierPhone) ? "" : $"· {_order.SupplierPhone}")
        · створено @Fmt.Date(_order.CreatedAt)
        @if (_order.OrderedAt is not null) { <text> · замовлено @Fmt.Date(_order.OrderedAt)</text> }
        @if (_order.ClosedAt is not null) { <text> · закрито @Fmt.Date(_order.ClosedAt)</text> }
    </MudText>

    <MudTable T="LineRow" Items="_rows" Dense="true" Outlined="true" Elevation="0" Class="mb-3">
        <HeaderContent>
            <MudTh>Позиція</MudTh>
            <MudTh Style="text-align: right">Замовлено</MudTh>
            <MudTh Style="text-align: right">Ціна</MudTh>
            <MudTh Style="text-align: right">Сума</MudTh>
            @if (!IsDraft)
            {
                <MudTh Style="text-align: right">Отримано</MudTh>
                <MudTh Style="text-align: right">Чекаємо</MudTh>
            }
            @if (IsOrdered)
            {
                <MudTh Style="width: 160px">Приїхало зараз</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Позиція"><MudLink Href="@StockRoutes.Item(context.Line.ItemId)">@context.Line.ItemName</MudLink></MudTd>
            @if (IsDraft)
            {
                <MudTd DataLabel="Замовлено">
                    <MudNumericField T="decimal" @bind-Value="context.Quantity" Format="0.###" Min="0" Margin="Margin.Dense" Adornment="Adornment.End"
                                     AdornmentText="@context.Line.Unit" />
                </MudTd>
                <MudTd DataLabel="Ціна">
                    <MudNumericField T="decimal" @bind-Value="context.Price" Format="0.##" Min="0" Margin="Margin.Dense" />
                </MudTd>
                <MudTd DataLabel="Сума" Style="text-align: right">@Fmt.Money(context.Quantity * context.Price)</MudTd>
            }
            else
            {
                <MudTd DataLabel="Замовлено" Style="text-align: right">@Fmt.Qty(context.Line.Quantity) @context.Line.Unit</MudTd>
                <MudTd DataLabel="Ціна" Style="text-align: right">@Fmt.Money(context.Line.Price)</MudTd>
                <MudTd DataLabel="Сума" Style="text-align: right">@Fmt.Money(context.Line.Sum)</MudTd>
                <MudTd DataLabel="Отримано" Style="text-align: right">@Fmt.Qty(context.Line.Received)</MudTd>
                <MudTd DataLabel="Чекаємо" Style="text-align: right">@Fmt.Qty(context.Line.Remaining)</MudTd>
            }
            @if (IsOrdered)
            {
                <MudTd DataLabel="Приїхало зараз">
                    <MudNumericField T="decimal" @bind-Value="context.Receive" Format="0.###" Min="0" Margin="Margin.Dense" Adornment="Adornment.End"
                                     AdornmentText="@context.Line.Unit" />
                </MudTd>
            }
        </RowTemplate>
    </MudTable>

    <div class="d-flex flex-wrap gap-2 mb-4">
        @if (IsDraft)
        {
            <MudButton Variant="Variant.Outlined" OnClick="SaveLinesAsync" Disabled="_busy">Зберегти зміни</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="MarkOrderedAsync" Disabled="_busy">
                Надіслано постачальнику
            </MudButton>
        }
        @if (IsOrdered)
        {
            @if (_warehouses.Count > 0)
            {
                <WarehouseSelect @bind-Value="_warehouseId" Warehouses="_warehouses" Label="Куди прийняти" Class="mud-width-auto" />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.MoveToInbox" OnClick="ReceiveAsync" Disabled="_busy">
                Прийняти на склад
            </MudButton>
        }
        @if (IsDraft || IsOrdered)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelAsync" Disabled="_busy">Скасувати замовлення</MudButton>
        }
    </div>

    @if (IsDraft || IsOrdered)
    {
        <MudPaper Class="pa-3" Outlined="true" MaxWidth="640px">
            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.subtitle1">Текст для постачальника</MudText>
                <MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync">Скопіювати</MudButton>
            </div>
            <MudText Typo="Typo.body2" Style="white-space: pre-line">@_order.MessageText</MudText>
        </MudPaper>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private PurchaseOrderDto? _order;
    private List<LineRow> _rows = [];
    private List<BreadcrumbItem> _breadcrumbs = [];
    private bool _busy;
    private List<LookupItem> _warehouses = [];
    private int? _warehouseId;

    private bool IsDraft => _order?.Status == PurchaseOrder.Draft;
    private bool IsOrdered => _order?.Status == PurchaseOrder.Ordered;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _order = await Api.PurchaseOrderAsync(Id);
        // У полі «приїхало зараз» одразу те, що ще чекаємо: найчастіше привозять усе.
        _rows = _order.Lines.Select(l => new LineRow(l) { Quantity = l.Quantity, Price = l.Price, Receive = l.Remaining }).ToList();
        _breadcrumbs = [new("Замовлення постачальникам", href: "stock/purchase-orders"), new($"№{Id}", href: null, disabled: true)];
        try
        {
            _warehouses = await Api.WarehousesAsync();
        }
        catch (ApiException)
        {
            _warehouses = []; // без довідника складів приймаємо на основний склад
        }
    }

    private Task SaveLinesAsync() => RunAsync("Зміни збережено.", () =>
        Api.SetPurchaseOrderLinesAsync(Id, new SetPurchaseOrderLinesRequest(
            _rows.Select(r => new PurchaseOrderLineRequest(r.Line.ItemId, r.Quantity, r.Price)).ToList())));

    private Task MarkOrderedAsync() => RunAsync("Позначено як надіслане постачальнику.", async () =>
    {
        // Незбережені зміни в кількостях спершу зберігаємо, щоб постачальнику пішло те, що на екрані.
        await Api.SetPurchaseOrderLinesAsync(Id, new SetPurchaseOrderLinesRequest(
            _rows.Select(r => new PurchaseOrderLineRequest(r.Line.ItemId, r.Quantity, r.Price)).ToList()));
        await Api.MarkOrderedAsync(Id);
    });

    private Task ReceiveAsync()
    {
        var receipts = _rows.Where(r => r.Receive > 0).Select(r => new ReceiptLineRequest(r.Line.Id, r.Receive)).ToList();
        if (receipts.Count == 0)
        {
            Snackbar.Add("Вкажіть, скільки приїхало.", Severity.Warning);
            return Task.CompletedTask;
        }
        return RunAsync("Прийнято на склад.", () => Api.ReceiveAsync(Id, new ReceivePurchaseOrderRequest(receipts, _warehouseId)));
    }

    private async Task CancelAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Скасувати замовлення?", "Уже отримане лишиться на складі, решту більше не чекаємо.", yesText: "Скасувати замовлення", cancelText: "Ні");
        if (confirmed == true)
            await RunAsync("Замовлення скасовано.", () => Api.CancelPurchaseOrderAsync(Id));
    }

    private async Task CopyAsync()
    {
        await Clipboard.CopyAsync(_order!.MessageText);
        Snackbar.Add("Текст скопійовано.", Severity.Info);
    }

    private async Task RunAsync(string success, Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            Snackbar.Add(success, Severity.Success);
            await LoadAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Рядок замовлення з полями, які людина редагує на екрані.</summary>
    private sealed class LineRow(PurchaseOrderLineDto line)
    {
        public PurchaseOrderLineDto Line { get; } = line;
        public decimal Quantity { get; set; }
        public decimal Price { get; set; }
        public decimal Receive { get; set; }
    }
}
