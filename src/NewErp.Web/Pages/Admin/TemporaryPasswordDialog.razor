@inject Clipboard Clipboard
@inject ISnackbar Snackbar

@* Показує тимчасовий пароль один раз: сервер його не зберігає у відкритому вигляді, тож пізніше побачити не вийде. *@
<MudDialog>
    <DialogContent>
        <MudText Class="mb-2">Передайте людині логін і пароль. Після входу система попросить задати власний пароль.</MudText>
        <MudPaper Class="pa-3 d-flex align-center gap-2" Outlined="true">
            <MudText Typo="Typo.body1">Логін: <b>@Username</b></MudText>
            <MudSpacer />
            <MudText Typo="Typo.h6" Style="font-family: monospace" data-test="temporary-password">@Password</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="Скопіювати пароль" OnClick="CopyAsync" />
        </MudPaper>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">Цей пароль показується лише зараз.</MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close()">Готово</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance Dialog { get; set; }

    [Parameter, EditorRequired] public string Username { get; set; } = "";

    [Parameter, EditorRequired] public string Password { get; set; } = "";

    private async Task CopyAsync()
    {
        await Clipboard.CopyAsync(Password);
        Snackbar.Add("Пароль скопійовано.", Severity.Info);
    }
}
