@page "/production/by-warehouse"
@attribute [Authorize(Roles = Access.Production)]
@inject ProductionApi Api

<PageTitle>Пошите за складами — NewErp</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Пошите за складами</MudText>
<MudText Typo="Typo.body2" Class="mb-3">
    Пошиті вироби кожного розміру активних моделей. Основний склад — це решта: усе, що не лежить на інших складах. Переміщують на картці моделі.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_report is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Outlined="true" Elevation="0" Style="overflow-x: auto">
        <thead>
            <tr>
                <th>Модель</th>
                <th>Розмір</th>
                <th style="text-align: right">Пошито</th>
                @foreach (var place in _report.Places)
                {
                    <th style="text-align: right">@place.Name</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _report.Rows)
            {
                <tr>
                    <td><MudLink Href="@ProductionUi.Model(row.ProductionId)">@row.ModelName</MudLink></td>
                    <td>@row.SizeName</td>
                    <td style="text-align: right">@Fmt.Qty(row.Total)</td>
                    @foreach (var quantity in row.Quantities)
                    {
                        <td style="text-align: right" class="@(quantity < 0 ? "mud-error-text" : null)">@(quantity == 0 ? "—" : Fmt.Qty(quantity))</td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private SewnByWarehouseDto? _report;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _report = await Api.ByWarehouseAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }
}
