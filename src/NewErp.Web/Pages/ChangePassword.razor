@page "/change-password"
@attribute [Authorize]
@inject HttpClient Http
@inject ApiAuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Зміна пароля — NewErp</PageTitle>

<MudPaper Class="pa-6" MaxWidth="480px" Elevation="1">
    <MudText Typo="Typo.h5" GutterBottom="true">Зміна пароля</MudText>
    @if (Auth.User is { MustChangePassword: true })
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Ви увійшли з тимчасовим паролем. Задайте власний, щоб продовжити роботу.
        </MudAlert>
    }
    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <MudTextField @bind-Value="_model.Current" Label="Поточний пароль" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_model.New" Label="Новий пароль" InputType="InputType.Password" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Required="true" Class="mb-3"
                      HelperText="@($"Щонайменше {PasswordPolicy.MinLength} символів, не такий, як логін")" />
        <MudTextField @bind-Value="_model.Repeat" Label="Новий пароль ще раз" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Class="mb-3" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Змінити</MudButton>
    </EditForm>
</MudPaper>

@code {
    private readonly ChangeModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = null;
        if (_model.New != _model.Repeat)
        {
            _error = "Нові паролі не збігаються.";
            return;
        }

        _busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/auth/change-password", new ChangePasswordRequest(_model.Current, _model.New));
            if (!response.IsSuccessStatusCode)
            {
                _error = await ApiErrors.ReadAsync(response);
                return;
            }

            Auth.PasswordChanged();
            Snackbar.Add("Пароль змінено.", Severity.Success);
            Navigation.NavigateTo("");
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ChangeModel
    {
        public string Current { get; set; } = "";

        public string New { get; set; } = "";

        public string Repeat { get; set; } = "";
    }
}
