<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Той самий UserSecretsId, що й у NewErp.Api: рядок підключення задається один раз. -->
    <UserSecretsId>newerp-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NewErp.Infrastructure\NewErp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Налаштування API (id статусів, мова): інструмент перевіряє, чи вони є в базі. Окрема назва, щоб не плутати з appsettings тестів. -->
    <None Include="..\..\src\NewErp.Api\appsettings.json" Link="api-appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
